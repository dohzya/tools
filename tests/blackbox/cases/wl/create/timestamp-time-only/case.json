{
  "tool": "wl",
  "fixture": "wl-project",
  "args": [
    "create",
    "Time only",
    "-t",
    "T11:15"
  ],
  "normalize": [
    "now-iso",
    "now-short",
    "wl-newid",
    "today"
  ],
  "behavior": "parity",
