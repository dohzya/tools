sections:
  - id: git-branch-track
    sh: git status --short --branch --ahead-behind | head -1 | cut -c4-
  - id: git-subdir
    builtin: git-subdir
    separator: none
  - id: git-ops
    builtin: git-ops
  - id: git-log
    builtin: git-log
    max_lines: 6
  - id: git-stash
    builtin: git-stash
  - id: status
    builtin: status
  - id: git-status
    alias: status
    deprecated: true
status_enrichers:
  - id: git-stats
    format: tsv
    builtin: git-stats
