{
  "tool": "dz-review",
  "fixture": "dz-review-session",
  "args": [
    "agent",
    "clean",
    "--validated",
    "--json"
  ],
  "files": [
    "doc.md",
    ".dz-review/agent-session.json"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/\"contentHash\": \"[0-9a-f]+\"/\"contentHash\": \"<H>\"/"
  ],
  "behavior": "parity"
}
