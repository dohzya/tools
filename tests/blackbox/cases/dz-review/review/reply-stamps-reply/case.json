{
  "tool": "dz-review",
  "fixture": "dz-review-plain",
  "args": [
    "review",
    "doc.md",
    "--handled"
  ],
  "files": [
    "doc.md",
    ".dz-review/reference-map.json"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/%[0-9A-Za-z]{8}([ |])/%<CTS>\\1/g"
  ],
  "behavior": "parity"
}
