{
  "tool": "dz-review",
  "fixture": "dz-review-stamped",
  "args": [
    "status"
  ],
  "files": [
    ".dz-review/reference-map.json",
    ".dz-review/agent-session.json"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/\"contentHash\": \"[0-9a-f]+\"/\"contentHash\": \"<H>\"/"
  ],
  "behavior": "parity",
  "note": "no file args: falls back to the files of the active session"
}
