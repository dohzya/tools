{
  "tool": "dz-review",
  "fixture": "dz-review-session",
  "args": [
    "--state-dir",
    "mystate",
    "session",
    "start",
    "doc.md"
  ],
  "files": [
    "mystate/agent-session.json",
    "mystate/reference-map.json"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/\"contentHash\": \"[0-9a-f]+\"/\"contentHash\": \"<H>\"/"
  ],
  "behavior": "parity"
}
