{
  "tool": "dz-review",
  "fixture": "dz-review-session",
  "args": [
    "session",
    "start",
    "mixed.md"
  ],
  "files": [
    "mixed.md",
    ".dz-review/agent-session.json",
    ".dz-review/reference-map.json"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/\"contentHash\": \"[0-9a-f]+\"/\"contentHash\": \"<H>\"/"
  ],
  "behavior": "parity"
}
