{
  "tool": "dz-review",
  "fixture": "dz-review-session",
  "args": [
    "session",
    "done"
  ],
  "files": [
    "compact.md"
  ],
  "normalize": [
    "iso-ts"
  ],
  "sed": [
    "s/\"contentHash\": \"[0-9a-f]+\"/\"contentHash\": \"<H>\"/",
    "s/%[0-9A-Za-z]{8}([ |])/%<CTS>\\1/g"
  ],
  "behavior": "parity",
  "note": "agent reply timestamp written in the file format after done"
}
